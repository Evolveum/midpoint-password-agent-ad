<Project Sdk="WixToolset.Sdk/7.0.1-e1">
  <PropertyGroup>
    <!-- We don't use official binaries, so the EULA (Open Source Maintenance Fee) does not apply. -->
    <AcceptEula>wix7</AcceptEula>
    <!-- Disable glob includes (**/*.wxs, **/*.wxl) to prevent double-inclusion when files
         are also listed explicitly, and to avoid glob expansion failures on network drives. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- ICE09: LsaDll is intentionally removable; lsass holds the file lock so
         Windows Installer schedules deletion on next reboot automatically. -->
    <SuppressIces>ICE09</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildProjectDirectory)\Package.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.1-e1" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.1-e1" />
  </ItemGroup>
</Project>
